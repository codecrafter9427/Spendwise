APP_ENV=development
APP_NAME=spendwise-api
LOG_LEVEL=INFO

# Async SQLAlchemy URL (asyncpg)
DATABASE_URL=postgresql+asyncpg://spendwise:spendwise@localhost:5432/spendwise

# Supabase Auth JWT verification (JWKS)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3000

# Test-only HS256 secret. Never set in staging/production.
# JWT_TEST_SECRET=

# Stage 7 AI (optional). Without AI_PROVIDER_API_KEY, assistant uses deterministic tools.
AI_FEATURE_ENABLED=true
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Stage 8 hardening
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_PER_WINDOW=120
RATE_LIMIT_AI_PER_WINDOW=20
